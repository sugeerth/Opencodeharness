{
 "name": "realworld-v1",
 "format": "openagent-manifest/1",
 "tasks": 71,
 "description": "Real changes from the histories of seven small open-source Python libraries. Each task starts from a commit's parent, is prompted with the commit message, and is graded by the commit's own tests, held out. Every task was validated: its tests fail on the parent and pass on the commit.",
 "requires": {
  "python": ">=3.11",
  "pip": [
   "pytest",
   "freezegun",
   "hypothesis"
  ]
 },
 "made_with": "openagent tasks from-git --look 400 -n 12 --test-cmd 'PYTHONPATH=src:. python -m pytest -q -x -p no:cacheprovider {tests}'",
